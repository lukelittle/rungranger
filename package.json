{
  "name": "rungranger",
  "private": true,
  "version": "0.1.0",
  "description": "RungRanger - a free, open-source, browser-based ladder logic programming and PLC simulation environment for education.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts --project=chromium"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.0.0",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
